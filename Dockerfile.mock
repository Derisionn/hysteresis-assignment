FROM python:3.11-slim

WORKDIR /app

# Install FastAPI and uvicorn
RUN pip install --no-cache-dir fastapi uvicorn

# Copy mock service
COPY mock_services /app/mock_services

# Expose port
EXPOSE 8001

# Run mock API
CMD ["uvicorn", "mock_services.external_api:app", "--host", "0.0.0.0", "--port", "8001"]
